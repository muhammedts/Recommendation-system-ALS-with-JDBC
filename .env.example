# Environment variables the job reads (all optional). The job does not load this file itself:
# use `docker run --env-file .env ...` or export the values in your shell.
DB_URL=jdbc:mysql://localhost:3306/books
DB_USER=root
DB_PASSWORD=
RATINGS_TABLE=ratings
RECOMMENDATIONS_TABLE=recommendations
TOP_N=10
ALS_RANK=10
ALS_MAX_ITER=10
ALS_REG_PARAM=0.1
TEST_FRACTION=0.2
SEED=42
SPARK_MASTER=local[*]
# 0 = run once and exit; >0 = keep running and retrain every N minutes
INTERVAL_MINUTES=0
